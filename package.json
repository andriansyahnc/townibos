{
  "name": "townibos",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev:api": "pnpm --filter @townibos/api run start:dev",
    "dev:web": "pnpm --filter @townibos/web run dev",
    "build:api": "pnpm --filter @townibos/api run build",
    "build:web": "pnpm --filter @townibos/web run build",
    "test": "pnpm --filter @townibos/api run test",
    "check": "biome check apps/",
    "check:fix": "biome check --write apps/",
    "prepare": "node -e \"if(process.env.NODE_ENV!=='production')require('child_process').execSync('husky',{stdio:'inherit'})\""
  },
  "lint-staged": {
    "apps/api/src/**/*.ts": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "apps/web/src/**/*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
