# App
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/townibos

# JWT
JWT_SECRET=your-super-secret-key
JWT_EXPIRES_IN=7d

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/telegram/webhook

# Anthropic (Claude for RAG)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Admin API key — used to reset passwords without a JWT (e.g. locked-out superadmin)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your-admin-api-key-here

# Encryption — AES-256-GCM key for sensitive fields (notionApiKey at rest)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Notion — API key and database ID are stored per-town in MongoDB (POST /towns)
# No global Notion env vars needed

# Voyage AI — used for semantic FAQ cache embeddings (optional)
# Get key from: https://dash.voyageai.com
# Omit to disable FAQ cache without errors
VOYAGE_API_KEY=your-voyage-api-key-here

# FAQ Cache — cosine similarity threshold (0.0–1.0, default 0.92)
# Higher = stricter matching; lower = more aggressive cache hits
FAQ_CACHE_SIMILARITY_THRESHOLD=0.92
