# App
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/townibos

# JWT
JWT_SECRET=your-super-secret-key
JWT_EXPIRES_IN=7d

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/telegram/webhook

# Anthropic (Claude for RAG)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Encryption — AES-256-GCM key for sensitive fields (notionApiKey at rest)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Notion — API key and database ID are stored per-town in MongoDB (POST /towns)
# No global Notion env vars needed
